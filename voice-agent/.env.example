# Realtime endpoint exposed by your local or private backend.
VITE_REALTIME_URL=wss://YOUR_REALTIME_HOST/v1/realtime
# Select "huggingface" for https://github.com/huggingface/speech-to-speech.
# The UI can also select this preset; this value sets its first-run default.
VITE_REALTIME_PRESET=custom
# Optional Custom / legacy PCM overrides. Leave these commented to use its
# 16 kHz defaults.
# VITE_OUTPUT_SAMPLE_RATE=16000
# VITE_INPUT_SAMPLE_RATE=16000
# Optional Hugging Face PCM overrides. The public server supports 16000 or
# 24000 only; leave these commented for its recommended 24 kHz defaults.
# VITE_HUGGING_FACE_OUTPUT_SAMPLE_RATE=24000
# VITE_HUGGING_FACE_INPUT_SAMPLE_RATE=24000
# Optional when the bridge is not running on the same machine as the browser.
VITE_BRIDGE_URL=ws://localhost:8080
